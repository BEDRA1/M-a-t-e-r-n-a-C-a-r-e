# قاعدة البيانات
POSTGRES_USER=materna
POSTGRES_PASSWORD=materna_secret
POSTGRES_DB=materna_care
POSTGRES_PORT=5433
DATABASE_URL="postgresql://materna:materna_secret@localhost:5433/materna_care?schema=public"

# التطبيق
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d
